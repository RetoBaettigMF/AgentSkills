# Copy to .env and fill in.

# --- OpenRouter (chat / LLM calls) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings ---
# OpenRouter does not currently expose an embeddings endpoint, so by default
# embeddings go to OpenAI. Point EMBEDDING_BASE_URL at any OpenAI-compatible
# embeddings endpoint you prefer.
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Data ---
# Override only if the markdowns live elsewhere.
# MARKDOWNS_PATH=/Users/morticiamac/Google Drive/Meine Ablage/Markdowns
