#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "openai>=1.40.0",
#   "python-dotenv>=1.0.0",
# ]
# ///
"""Incrementally rebuild index.md inside the Markdowns folder.

Maintains summary_cache.json keyed by relative path (mtime + summary).
Only new or changed files are sent to the LLM; deleted files are dropped.
Files that previously failed (no cached summary) are retried on the next run.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _lib import (
    SUMMARY_CACHE_PATH,
    get_markdowns_path,
    iter_markdown_files,
    load_env,
    load_summary_cache,
    save_summary_cache,
    summarize_file,
)


def main() -> int:
    load_env()
    root = get_markdowns_path()
    cache = load_summary_cache()

    current: dict[str, float] = {}
    for f in iter_markdown_files(root):
        current[str(f.relative_to(root))] = f.stat().st_mtime

    removed = [key for key in cache if key not in current]
    for key in removed:
        print(f"Removing {key}", file=sys.stderr)
        del cache[key]

    added = changed = skipped = failed = 0
    for key, mtime in current.items():
        entry = cache.get(key)
        if entry and entry.get("mtime") == mtime and entry.get("summary"):
            skipped += 1
            continue
        f = root / key
        content = f.read_text(encoding="utf-8", errors="replace")
        if not content.strip():
            cache[key] = {"mtime": mtime, "summary": "(empty file)"}
            continue
        action = "Updating" if entry else "Adding"
        print(f"{action} {key}...", file=sys.stderr)
        try:
            summary = summarize_file(key, content)
        except Exception as e:
            print(f"  failed: {e}", file=sys.stderr)
            failed += 1
            cache[key] = {"mtime": mtime, "summary": None, "error": str(e)}
            continue
        cache[key] = {"mtime": mtime, "summary": summary}
        if entry:
            changed += 1
        else:
            added += 1

    save_summary_cache(cache)
    _write_index(root, cache)

    print(
        f"summary_cache.json: {added} added, {changed} changed, "
        f"{skipped} unchanged, {len(removed)} removed, {failed} failed",
        file=sys.stderr,
    )
    return 0 if failed == 0 else 1


def _write_index(root: Path, cache: dict) -> None:
    by_dir: dict[str, list[str]] = {}
    for key in cache:
        rel = Path(key)
        parent = str(rel.parent) if str(rel.parent) != "." else ""
        by_dir.setdefault(parent, []).append(key)

    lines: list[str] = [
        "# Sabbatical Markdowns Index",
        "",
        f"Total files: {len(cache)}",
        "",
        "_Auto-generated by the `sabbatical` skill — do not edit by hand._",
    ]
    for dir_name in sorted(by_dir.keys()):
        lines.append("")
        lines.append(f"## {dir_name or '(root)'}")
        for key in sorted(by_dir[dir_name]):
            entry = cache[key]
            summary = entry.get("summary") or f"(summary failed: {entry.get('error', 'unknown')})"
            lines.append("")
            lines.append(f"### `{key}`")
            lines.append("")
            lines.append(summary)

    index_path = root / "index.md"
    index_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(
        f"Wrote {index_path} ({len(cache)} files indexed) and {SUMMARY_CACHE_PATH}",
        file=sys.stderr,
    )


if __name__ == "__main__":
    sys.exit(main())
